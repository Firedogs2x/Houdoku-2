{
  "name": "houdoku-mono",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "preview": "turbo preview",
    "dist:win": "turbo run dist:win --filter=@houdoku/desktop",
    "dist:mac": "turbo run dist:mac --filter=@houdoku/desktop",
    "dist:linux": "turbo run dist:linux --filter=@houdoku/desktop",
    "dist:win:dev": "turbo run dist:win:dev --filter=@houdoku/desktop",
    "dist:mac:dev": "turbo run dist:mac:dev --filter=@houdoku/desktop",
    "dist:linux:dev": "turbo run dist:linux:dev --filter=@houdoku/desktop"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "prettier": "^3.2.5",
    "turbo": "^2.3.3",
    "typescript": "5.5.4"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  },
  "version": "0.0.5"
}
