{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "verify-dist-win",
			"type": "shell",
			"command": "corepack",
			"args": [
				"pnpm",
				"--filter",
				"@houdoku/desktop",
				"dist:win"
			],
			"isBackground": false
		},
		{
			"label": "clear-release-lockers",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-Command",
				"$names = 'Houdoku','electron','electron-builder','7za'; Get-Process | Where-Object { $names -contains $_.ProcessName } | Stop-Process -Force -ErrorAction SilentlyContinue; Write-Output 'CLEARED'"
			],
			"isBackground": false
		},
		{
			"label": "clear-release-lockers-2",
			"type": "shell",
			"command": "$names = @('Houdoku','electron','electron-builder','7za'); Get-Process | Where-Object { $names -contains $_.ProcessName } | Stop-Process -Force -ErrorAction SilentlyContinue; Write-Output 'CLEARED'",
			"isBackground": false
		},
		{
			"label": "verify-dist-win-2",
			"type": "shell",
			"command": "corepack pnpm --filter @houdoku/desktop dist:win",
			"isBackground": false
		},
		{
			"label": "verify-dist-win-zip-only",
			"type": "shell",
			"command": "corepack pnpm --filter @houdoku/desktop exec electron-builder --win zip --publish never",
			"isBackground": false
		},
		{
			"label": "verify-root-lint",
			"type": "shell",
			"command": "corepack pnpm lint",
			"isBackground": false
		},
		{
			"label": "verify-dist-win-zip-only-bottom-lock",
			"type": "shell",
			"command": "corepack pnpm --filter @houdoku/desktop exec electron-builder --win zip --publish never",
			"isBackground": false
		},
		{
			"label": "install-updated-deps",
			"type": "shell",
			"command": "corepack pnpm install",
			"isBackground": false
		},
		{
			"label": "install-ts-upgrade",
			"type": "shell",
			"command": "corepack pnpm install",
			"isBackground": false
		},
		{
			"label": "build-desktop-only",
			"type": "shell",
			"command": "corepack pnpm --filter @houdoku/desktop build",
			"isBackground": false
		},
		{
			"label": "install-ts7",
			"type": "shell",
			"command": "corepack pnpm install",
			"isBackground": false
		},
		{
			"label": "build-ts7",
			"type": "shell",
			"command": "corepack pnpm --filter @houdoku/desktop build",
			"isBackground": false
		},
		{
			"label": "install-phase4",
			"type": "shell",
			"command": "corepack pnpm install",
			"isBackground": false
		},
		{
			"label": "build-phase4",
			"type": "shell",
			"command": "corepack pnpm --filter @houdoku/desktop build",
			"isBackground": false
		}
	]
}